    </div>

    <div class="stats">

        <div class="stat">

            <div
                id="score"
                class="stat-number">
                0
            </div>

            <div class="stat-name">
                Score
            </div>

        </div>


        <div class="stat">

            <div
                id="streak"
                class="stat-number">
                0
            </div>

            <div class="stat-name">
                Streak
            </div>

        </div>


        <div class="stat">

            <div
                id="rolls"
                class="stat-number">
                0
            </div>

            <div class="stat-name">
                Rolls
            </div>

        </div>

    </div>
</div>


<!-- НОВАЯ ИСТОРИЯ -->

<div class="panel">

