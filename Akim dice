<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AKIM DICE</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    font-family: Arial, sans-serif;
    color: white;
    background: #080b12;
    transition: background .4s ease;
    overflow-x: hidden;
}

body.bg-dark {
    background: radial-gradient(circle at top, #182033 0%, #080b12 60%);
}

body.bg-blue {
    background: radial-gradient(circle at top, #123a69 0%, #080b12 65%);
}

body.bg-purple {
    background: radial-gradient(circle at top, #42145d 0%, #080b12 65%);
}

body.bg-red {
    background: radial-gradient(circle at top, #5d1515 0%, #080b12 65%);
}

body.bg-green {
    background: radial-gradient(circle at top, #14552e 0%, #080b12 65%);
}

body.bg-yellow {
    background: radial-gradient(circle at top, #5b4b0c 0%, #080b12 65%);
}

body.bg-orange {
    background: radial-gradient(circle at top, #65300d 0%, #080b12 65%);
}

.container {
    width: min(1050px, 94%);
    margin: auto;
    padding: 22px 0 50px;
}

/* HEADER */

header {
    text-align: center;
    margin-bottom: 22px;
}

.logo {
    font-size: 40px;
    font-weight: 900;
    letter-spacing: 4px;
    text-shadow:
        0 0 10px #00eaff,
        0 0 25px #00eaff;
}

.subtitle {
    margin-top: 6px;
    color: #8191a5;
    font-size: 13px;
}

/* PANEL */

.panel {
    background: rgba(15,21,32,.78);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px;
    padding: 18px;
    margin-bottom: 16px;
    box-shadow:
        0 10px 35px rgba(0,0,0,.25),
        inset 0 1px rgba(255,255,255,.03);
    backdrop-filter: blur(12px);
}

.panel-title {
    color: #71849c;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 13px;
}

/* SETTINGS */

.settings {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 13px;
}

.setting {
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 12px;
    padding: 13px;
}

.setting label {
    display: block;
    font-size: 11px;
    color: #8293a9;
    margin-bottom: 7px;
}

select {
    width: 100%;
    background: #111827;
    color: white;
    border: 1px solid #29364a;
    border-radius: 9px;
    padding: 10px;
    outline: none;
}

/* DICE */

.dice-area {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding: 12px 0;
}

.dice-row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 10px;

    /*
       Важно:
       ряд не двигается.
    */
    width: 100%;
    max-width: 560px;
}

/* КУБИКИ СДЕЛАНЫ МЕНЬШЕ */

.dice {
    flex: 0 0 68px;
    width: 68px;
    height: 68px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #505965;
    border: 2px solid #69727e;

    box-shadow: 0 7px 18px rgba(0,0,0,.35);

    transition:
        background .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
}

.dice-placeholder::after {
    content: "—";
    color: #cbd1d8;
    font-size: 28px;
    font-weight: 700;
}

.dice-dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 10px rgba(255,255,255,.8);
}

/* COLORS */

.dice.red {
    background: #ff3030;
    border-color: #ff5c5c;
    box-shadow: 0 0 20px rgba(255,48,48,.6);
}

.dice.yellow {
    background: #ffd51f;
    border-color: #ffe45e;
    box-shadow: 0 0 20px rgba(255,213,31,.6);
}

.dice.orange {
    background: #ff781f;
    border-color: #ff9a5c;
    box-shadow: 0 0 20px rgba(255,120,31,.6);
}

.dice.blue {
    background: #248cff;
    border-color: #65adff;
    box-shadow: 0 0 20px rgba(36,140,255,.6);
}

.dice.purple {
    background: #a83cff;
    border-color: #c67aff;
    box-shadow: 0 0 20px rgba(168,60,255,.6);
}

.dice.green {
    background: #24d96b;
    border-color: #65ed98;
    box-shadow: 0 0 20px rgba(36,217,107,.6);
}

/* BUTTONS */

.buttons {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
}

button {
    border: none;
    border-radius: 11px;
    padding: 13px 21px;
    color: white;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
}

.roll-btn {
    background: linear-gradient(135deg,#087eff,#00c6ff);
    box-shadow: 0 0 18px rgba(0,198,255,.25);
}

.mega-btn {
    background: linear-gradient(135deg,#8d20ff,#d43dff);
    box-shadow: 0 0 22px rgba(180,50,255,.3);
}

.back-btn {
    background: #263143;
    border: 1px solid #3b4a60;
}

button:disabled {
    opacity: .5;
    cursor: default;
}

/* STATS */

.stats {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 10px;
}

.stat {
    text-align: center;
    background: rgba(255,255,255,.035);
    border-radius: 12px;
    padding: 14px;
}

.stat-number {
    font-size: 25px;
    font-weight: 900;
}

.stat-name {
    color: #71849c;
    font-size: 10px;
    margin-top: 4px;
    text-transform: uppercase;
}

/* HISTORY */

.history {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.history-empty {
    text-align: center;
    color: #65758a;
    padding: 12px;
    font-size: 13px;
}

.history-item {
    display: flex;
    align-items: center;
    gap: 10px;

    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 11px;

    padding: 9px 11px;
}

.history-number {
    width: 34px;
    color: #72849a;
    font-size: 11px;
    font-weight: 700;
}

.history-type {
    width: 65px;
    color: #aab6c5;
    font-size: 10px;
    font-weight: 800;
}

.history-dice {
    display: flex;
    gap: 5px;
    flex: 1;
}

.history-color {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,.2);
}

.history-color.red { background:#ff3030; }
.history-color.yellow { background:#ffd51f; }
.history-color.orange { background:#ff781f; }
.history-color.blue { background:#248cff; }
.history-color.purple { background:#a83cff; }
.history-color.green { background:#24d96b; }

.history-time {
    color: #5f7085;
    font-size: 10px;
}

/* VERIFY */

.verify {
    display: flex;
    gap: 9px;
}

.verify input {
    flex: 1;
    min-width: 0;
    background: #111827;
    border: 1px solid #29364a;
    border-radius: 9px;
    color: white;
    padding: 11px;
    outline: none;
}

.verify button {
    background: #1d2939;
}

/* SCREEN */

.screen {
    display: none;
}

.screen.active {
    display: block;
}

/* MEGA SCREEN */

.mega-screen {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.mega-title {
    text-align: center;
    margin-bottom: 30px;
}

.mega-title h2 {
    font-size: 29px;
    text-shadow:
        0 0 10px #b42fff,
        0 0 25px #b42fff;
}

.mega-title p {
    color: #8191a5;
    margin-top: 7px;
    font-size: 12px;
}

.mega-dice-area {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding: 10px 0 25px;
}

.mega-dice-row {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 650px;
}

.mega-dice {
    flex: 0 0 68px;
    width: 68px;
    height: 68px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #464e59;
    border: 2px solid #68717d;

    color: #d2d7dc;
    font-size: 29px;
    font-weight: 900;

    box-shadow: 0 8px 20px rgba(0,0,0,.35);

    transition:
        background .3s ease,
        border-color .3s ease,
        box-shadow .3s ease;
}

.mega-dice.red {
    background:#ff3030;
    border-color:#ff5c5c;
    box-shadow:0 0 23px rgba(255,48,48,.65);
}

.mega-dice.yellow {
    background:#ffd51f;
    border-color:#ffe45e;
    box-shadow:0 0 23px rgba(255,213,31,.65);
}

.mega-dice.orange {
    background:#ff781f;
    border-color:#ff9a5c;
    box-shadow:0 0 23px rgba(255,120,31,.65);
}

.mega-dice.blue {
    background:#248cff;
    border-color:#65adff;
    box-shadow:0 0 23px rgba(36,140,255,.65);
}

.mega-dice.purple {
    background:#a83cff;
    border-color:#c67aff;
    box-shadow:0 0 23px rgba(168,60,255,.65);
}

.mega-dice.green {
    background:#24d96b;
    border-color:#65ed98;
    box-shadow:0 0 23px rgba(36,217,107,.65);
}

.mega-status {
    text-align: center;
    color: #91a1b5;
    min-height: 22px;
    margin-bottom: 18px;
}

/* MOBILE */

@media (max-width:700px) {

    .container {
        width: 95%;
        padding-top: 17px;
    }

    .logo {
        font-size: 31px;
    }

    .settings {
        grid-template-columns: 1fr;
    }

    .dice-row,
    .mega-dice-row {
        gap: 7px;
    }

    .dice {
        flex-basis: 58px;
        width: 58px;
        height: 58px;
        border-radius: 12px;
    }

    .dice-dot {
        width: 13px;
        height: 13px;
    }

    .dice-placeholder::after {
        font-size: 24px;
    }

    .mega-dice {
        flex-basis: 58px;
        width: 58px;
        height: 58px;
        border-radius: 12px;
        font-size: 25px;
    }

    .stats {
        grid-template-columns: repeat(3,1fr);
    }

    .history-item {
        gap: 6px;
        padding: 8px;
    }

    .history-number {
        width: 25px;
    }

    .history-type {
        width: 48px;
        font-size: 9px;
    }

    .history-time {
        display: none;
    }

    .verify {
        flex-direction: column;
    }

    .verify button {
        width: 100%;
    }
}
</style>
</head>

<body class="bg-dark">

<div class="container">

<!-- ================================= -->
<!-- ПЕРВЫЙ ЭКРАН -->
<!-- ================================= -->

<section id="mainScreen" class="screen active">

<header>
    <div class="logo">AKIM DICE</div>
    <div class="subtitle">NEON COLOR DICE</div>
</header>


<!-- НАСТРОЙКИ -->

<div class="panel">

    <div class="panel-title">Настройки</div>

    <div class="settings">

        <div class="setting">
            <label>Количество кубиков</label>

            <select id="diceCount">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
