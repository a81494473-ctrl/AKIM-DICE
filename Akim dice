</div>

</section>


<!-- ================================= -->
<!-- ВТОРОЙ ЭКРАН -->
<!-- ================================= -->

<section
    id="megaScreen"
    class="screen mega-screen">

    <div class="mega-title">

        <h2>
            ⚡ МЕГА БРОСОК
        </h2>

        <p>
            Цвета открываются по одному
        </p>

    </div>


    <div class="mega-dice-area">

        <div
            id="megaDiceRow"
            class="mega-dice-row">
        </div>

    </div>


