                </option>
            </select>
        </div>


        <div class="setting">
            <label>Фон</label>

            <select id="background">

                <option value="dark">
                    Dark
                </option>

                <option value="blue">
                    Blue
                </option>

                <option value="purple">
                    Purple
                </option>

                <option value="red">
                    Red
                </option>

                <option value="green">
                    Green
                </option>

                <option value="yellow">
                    Yellow
                </option>

                <option value="orange">
                    Orange
                </option>

            </select>
        </div>

    </div>
</div>


<!-- КУБИКИ -->

<div class="panel">

    <div class="panel-title">
        Кубики
    </div>

    <div class="dice-area">
        <div id="diceRow" class="dice-row"></div>
    </div>


    <div class="buttons">

        <button
            id="rollButton"
            class="roll-btn"
            onclick="rollDice()">

            🎲 БРОСИТЬ

        </button>


        <button
            id="megaButton"
            class="mega-btn"
            onclick="openMegaScreen()">

            ⚡ МЕГА БРОСОК

        </button>

    </div>

</div>


<!-- СТАТИСТИКА -->

<div class="panel">

    <div class="panel-title">
