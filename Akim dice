<script>

/* ==========================================
   ДАННЫЕ
========================================== */

const colors = [
    "red",
    "yellow",
    "orange",
    "blue",
    "purple",
    "green"
];

let diceCount = 4;
let rollMode = "random";

let score = 0;
let streak = 0;
let rolls = 0;

let history = [];

let isRolling = false;
let megaRunning = false;

/*
   Последний результат.
   Он НЕ сбрасывается после Mega.
*/
let currentResult = [];


/* ==========================================
   ELEMENTS
========================================== */

const diceRow =
    document.getElementById("diceRow");

const megaDiceRow =
    document.getElementById("megaDiceRow");

const diceCountSelect =
    document.getElementById("diceCount");

const rollModeSelect =
    document.getElementById("rollMode");

const backgroundSelect =
    document.getElementById("background");


/* ==========================================
   СОЗДАНИЕ КУБИКОВ
========================================== */

function createDice() {

    diceRow.innerHTML = "";

    for (let i = 0; i < diceCount; i++) {

        const dice =
            document.createElement("div");

        /*
           Если уже есть результат,
           показываем его.

           Если результата нет —
           серый кубик.
        */

        if (currentResult[i]) {

            setDiceColor(
                dice,
                currentResult[i]
            );

        } else {

            dice.className =
                "dice dice-placeholder";
        }

        diceRow.appendChild(dice);
    }
}


/* ==========================================
   RANDOM COLOR
========================================== */

function getRandomColor() {

    return colors[
        Math.floor(
            Math.random() * colors.length
        )
    ];
}


/* ==========================================
   РЕЗУЛЬТАТ БРОСКА
========================================== */

function getRollColors() {

    const result = [];

    if (rollMode === "same") {

        const color =
            getRandomColor();

        for (
            let i = 0;
            i < diceCount;
            i++
        ) {
            result.push(color);
        }

    } else {

        for (
            let i = 0;
            i < diceCount;
            i++
        ) {
            result.push(
                getRandomColor()
            );
        }
    }

    return result;
}


/* ==========================================
   УСТАНОВИТЬ ЦВЕТ
========================================== */

function setDiceColor(
    dice,
    color
) {

    dice.className =
        "dice " + color;

    dice.innerHTML =
        '<div class="dice-dot"></div>';
}


/* ==========================================
   ОБЫЧНЫЙ БРОСОК
========================================== */

function rollDice() {

    if (
        isRolling ||
        megaRunning
    ) {
        return;
    }

    isRolling = true;

    const result =
        getRollColors();

    currentResult =
        [...result];

    const diceElements =
        Array.from(
            diceRow.children
        );


    /*
       Кубики остаются абсолютно
       неподвижными.

       Меняется только цвет.
    */

    diceElements.forEach(
        (dice, index) => {

            setTimeout(() => {

                setDiceColor(
                    dice,
                    result[index]
                );

            }, index * 90);

        }
    );


    setTimeout(() => {

        finishRoll(
            result,
            "NORMAL"
        );

        isRolling = false;

    }, diceCount * 90 + 150);
}


/* ==========================================
   ЗАВЕРШЕНИЕ
========================================== */

function finishRoll(
    result,
    type
) {

    rolls++;

    score += result.length;

    streak++;

    updateStats();

    addHistory(
        result,
        type
    );
}


/* ==========================================
   СТАТИСТИКА
========================================== */

function updateStats() {

    document.getElementById(
        "score"
    ).textContent = score;

    document.getElementById(
        "streak"
    ).textContent = streak;

    document.getElementById(
        "rolls"
    ).textContent = rolls;
}


/* ==========================================
   НОВАЯ ИСТОРИЯ
========================================== */

function addHistory(
    result,
    type
) {

    const now =
        new Date();

    const time =
        now.toLocaleTimeString(
            "ru-RU",
            {
                hour: "2-digit",
                minute: "2-digit"
            }
        );


    history.unshift({

        number: rolls,

        type: type,

        colors: [...result],

        time: time

    });


    /*
       Храним последние 15 бросков.
    */

    if (history.length > 15) {
        history.pop();
    }


    renderHistory();
}


/* ==========================================
   ОТОБРАЖЕНИЕ ИСТОРИИ
========================================== */

function renderHistory() {

    const historyElement =
        document.getElementById(
            "history"
        );

    historyElement.innerHTML = "";


    if (history.length === 0) {

        historyElement.innerHTML =
            '<div class="history-empty">' +
            'Пока бросков нет' +
            '</div>';

        return;
    }


    history.forEach(item => {

        const row =
            document.createElement("div");

        row.className =
            "history-item";


        const number =
            document.createElement("div");

        number.className =
            "history-number";

        number.textContent =
            "#" + item.number;


        const type =
            document.createElement("div");

        type.className =
            "history-type";

        type.textContent =
            item.type === "MEGA"
                ? "⚡ MEGA"
                : "🎲 БРОСОК";


        const dice =
            document.createElement("div");

        dice.className =
            "history-dice";


        item.colors.forEach(color => {

            const colorElement =
                document.createElement("div");

            colorElement.className =
                "history-color " + color;

            colorElement.title =
                color;

            dice.appendChild(
                colorElement
            );

        });


        const time =
            document.createElement("div");

        time.className =
            "history-time";

        time.textContent =
            item.time;


        row.appendChild(number);
        row.appendChild(type);
        row.appendChild(dice);
        row.appendChild(time);

        historyElement.appendChild(row);

    });
}


/* ==========================================
   ОТКРЫТЬ MEGA
========================================== */

function openMegaScreen() {

    if (
        megaRunning ||
        isRolling
    ) {
        return;
    }


    document.getElementById(
        "mainScreen"
    ).classList.remove(
        "active"
    );


    document.getElementById(
        "megaScreen"
    ).classList.add(
        "active"
    );


    startMegaRoll();
}


/* ==========================================
   СЕРЫЕ ПРОЧЕРКИ
========================================== */

function createMegaPlaceholders() {

    megaDiceRow.innerHTML = "";

    for (
        let i = 0;
        i < diceCount;
        i++
    ) {

        const dice =
            document.createElement("div");

        dice.className =
            "mega-dice";

        dice.textContent =
            "—";

        megaDiceRow.appendChild(
            dice
        );
    }
}


/* ==========================================
   MEGA
========================================== */

function startMegaRoll() {

    megaRunning = true;

    createMegaPlaceholders();


    const status =
        document.getElementById(
            "megaStatus"
        );

    status.textContent =
        "Цвета определяются...";


    const result =
        getRollColors();


    /*
       Сохраняем результат сразу,
       чтобы после Mega он остался
       на первом экране.
    */

    currentResult =
        [...result];


    const diceElements =
        Array.from(
            megaDiceRow.children
        );


    /*
       Каждый цвет открывается
       примерно раз в 700 мс.

       Никаких движений.
    */

    diceElements.forEach(
        (dice, index) => {

            setTimeout(() => {

                dice.className =
                    "mega-dice " +
                    result[index];

                dice.textContent = "";

            }, 700 * (index + 1));

        }
    );


    const finishTime =
        700 * diceCount + 500;


    setTimeout(() => {

        finishRoll(
            result,
            "MEGA"
        );


        status.textContent =
            "МЕГА БРОСОК завершён";


        megaRunning = false;


        /*
           После завершения обновляем
           первый экран.

           Именно здесь цвета Mega
           закрепляются на обычных
           кубиках.
        */

        createDice();

    }, finishTime);
}


/* ==========================================
   НАЗАД
========================================== */

function closeMegaScreen() {

    /*
       Во время Mega нельзя уйти,
       чтобы не оборвать результат.
    */

    if (megaRunning) {
        return;
    }


    document.getElementById(
        "megaScreen"
    ).classList.remove(
        "active"
    );


    document.getElementById(
        "mainScreen"
    ).classList.add(
        "active"
    );


    /*
       Показываем последний результат.
    */

    createDice();
}


/* ==========================================
   КОЛИЧЕСТВО КУБИКОВ
========================================== */

diceCountSelect.addEventListener(
    "change",
    function() {

        diceCount =
            Number(this.value);


        /*
           Если количество изменилось,
           старый результат больше
           не подходит.
        */

        currentResult = [];

        createDice();
    }
);


/* ==========================================
   РЕЖИМ
========================================== */

rollModeSelect.addEventListener(
    "change",
    function() {

        rollMode =
            this.value;
    }
);


/* ==========================================
   ФОН
========================================== */

backgroundSelect.addEventListener(
    "change",
    function() {

        setBackground(
            this.value
        );

        localStorage.setItem(
            "akimDiceBackground",
            this.value
        );
    }
);


function setBackground(bg) {

    document.body.className =
        "bg-" + bg;
}


/* ==========================================
   GAME ID
========================================== */

function verifyGame() {

    const input =
        document.getElementById(
            "gameId"
        );

    const result =
        document.getElementById(
            "verifyResult"
        );

    const id =
        input.value.trim();


    if (!id) {

        result.textContent =
            "Введите Game ID.";

        result.style.color =
            "#ff6b6b";

        return;
    }


    result.textContent =
        "Game ID принят.";

    result.style.color =
        "#55e889";
}


/* ==========================================
   ЗАГРУЗКА
========================================== */

function loadSettings() {

    const savedBackground =
        localStorage.getItem(
            "akimDiceBackground"
        );


    if (savedBackground) {

        backgroundSelect.value =
            savedBackground;

        setBackground(
            savedBackground
        );

    } else {

        setBackground("dark");
    }
}


/* ==========================================
   START
========================================== */

loadSettings();

createDice();

updateStats();

renderHistory();

</script>

